# ---------------------------------------------------------------------------
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# The "Ask about my work" assistant tries these providers in order: Groq first,
# Gemini as the fallback. Set at least one. Server-side only — never give these
# a NEXT_PUBLIC_ prefix. Without any key the assistant degrades gracefully: the
# UI tells visitors it is offline and points them at the sections instead.

# https://console.groq.com/keys
GROQ_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides.
# Defaults: openai/gpt-oss-120b (Groq), gemini-3.6-flash (Gemini).
GROQ_MODEL=
GEMINI_MODEL=

# Optional. A GitHub fine-grained token with public read access only.
# Raises the GitHub API rate limit for the repository strip. The section
# renders from the API without it, and hides itself if the request fails.
GITHUB_TOKEN=

# Optional. Canonical site origin, used for metadata, sitemap and OG tags.
# Defaults to https://rishikesh-portfolio-2025.vercel.app
NEXT_PUBLIC_SITE_URL=
